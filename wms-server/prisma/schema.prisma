generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  ADMIN
  OPERATOR
  CHECKER
}

enum CargoStatus {
  OPEN
  LOADING
  DEPARTED
}

enum DeliveryStatus {
  GENERATED
}

enum ScanResult {
  OK
  ERROR
  WARNING
  UNDO
}

enum ScanReason {
  NOT_FOUND
  ALREADY_LOADED
  WRONG_CARGO
  CARGO_DEPARTED
}

model Company {
  id                Int      @id @default(autoincrement())
  cnpj              String
  name              String
  tradeName         String?  @map("trade_name")
  stateRegistration String?  @map("state_registration")
  phone             String?
  street            String?
  streetNumber      String?  @map("street_number")
  neighborhood      String?
  city              String?
  state             String?  @db.Char(2)
  zipCode           String?  @map("zip_code")
  licenseKey        String?  @map("license_key")
  licenseToken      String?  @map("license_token") @db.Text
  settings          Json?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("companies")
}

model User {
  id             Int            @id @default(autoincrement())
  name           String
  username       String         @unique
  passwordHash   String         @map("password_hash")
  role           UserRole       @default(OPERATOR)
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  scans          ScanLog[]
  departedCargos Cargo[]
  volumesLoaded  Volume[]
  driverReviews  DriverReview[]
  cargoReopens   CargoReopen[]

  @@map("users")
}

model Client {
  id           Int        @id @default(autoincrement())
  name         String
  document     String?    @unique
  address      String?
  neighborhood String?
  city         String
  state        String?    @db.Char(2)
  zipCode      String?    @map("zip_code")
  phone        String?
  deliveries   Delivery[]

  @@map("clients")
}

// Cadastro de motoristas. Cargo mantém driverName/driverPhone como snapshot.
model Driver {
  id        Int            @id @default(autoincrement())
  name      String
  phone     String?
  active    Boolean        @default(true)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  cargos    Cargo[]
  reviews   DriverReview[]

  @@index([name])
  @@map("drivers")
}

// Avaliação manual de motorista (nota + comentário), opcionalmente ligada a uma carga.
model DriverReview {
  id        Int      @id @default(autoincrement())
  driverId  Int      @map("driver_id")
  cargoId   Int?     @map("cargo_id")
  userId    Int      @map("user_id")
  rating    Int
  comment   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  driver    Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  cargo     Cargo?   @relation(fields: [cargoId], references: [id], onDelete: SetNull)
  user      User     @relation(fields: [userId], references: [id])

  @@index([driverId])
  @@index([cargoId])
  @@index([userId])
  @@map("driver_reviews")
}

// Histórico de reaberturas de carga (motivo obrigatório em POST /cargos/:id/reopen).
model CargoReopen {
  id        Int      @id @default(autoincrement())
  cargoId   Int      @map("cargo_id")
  userId    Int      @map("user_id")
  reason    String   @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")
  cargo     Cargo    @relation(fields: [cargoId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@index([cargoId])
  @@index([userId])
  @@map("cargo_reopens")
}

// Cadastro de produtos. DeliveryItem mantém code/product/weight/volumeCount como snapshot.
model Product {
  id          Int            @id @default(autoincrement())
  code        String         @unique
  name        String
  weight      Decimal?       @db.Decimal(10, 3)
  volumeCount Int?           @map("volume_count")
  active      Boolean        @default(true)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  items       DeliveryItem[]

  @@index([name])
  @@map("products")
}

// Contadores para numeração automática (ex.: key "romaneio:2026").
model NumberSequence {
  key   String @id
  value Int    @default(0)

  @@map("number_sequences")
}

model Cargo {
  id                      Int            @id @default(autoincrement())
  loadOrder               String         @unique @map("load_order")
  totalDestinations       Int            @map("total_destinations")
  status                  CargoStatus    @default(OPEN)
  loadDate                DateTime       @map("load_date") @db.Date
  issueDate               DateTime       @map("issue_date") @db.Date
  driverId                Int?           @map("driver_id")
  driverName              String?        @map("driver_name")
  driverPhone             String?        @map("driver_phone")
  truck                   String?
  inspectionResponsible   String?        @map("inspection_responsible")
  organizationResponsible String?        @map("organization_responsible")
  assistant1              String?        @map("assistant_1")
  loadingResponsible      String?        @map("loading_responsible")
  warehouseKeeper         String?        @map("warehouse_keeper")
  romaneioResponsible     String?        @map("romaneio_responsible")
  startedAt               DateTime?      @map("started_at")
  endedAt                 DateTime?      @map("ended_at")
  departedAt              DateTime?      @map("departed_at")
  createdAt               DateTime       @default(now()) @map("created_at")
  updatedAt               DateTime       @updatedAt @map("updated_at")
  departedById            Int?           @map("departed_by_id")
  pendingAtDeparture      Int?           @map("pending_at_departure")
  departedBy              User?          @relation(fields: [departedById], references: [id])
  driver                  Driver?        @relation(fields: [driverId], references: [id], onDelete: SetNull)
  deliveries              Delivery[]
  scans                   ScanLog[]
  driverReviews           DriverReview[]
  reopens                 CargoReopen[]

  @@index([createdAt])
  @@index([status, createdAt])
  @@index([driverId])
  @@map("cargos")
}

model Delivery {
  id                 Int            @id @default(autoincrement())
  cargoId            Int            @map("cargo_id")
  sequence           Int
  romaneioNumber     String         @unique @map("romaneio_number")
  biddingNumber      String?        @map("bidding_number")
  modality           String?
  hasInstallation    Boolean        @default(false) @map("has_installation")
  status             DeliveryStatus @default(GENERATED)
  cargo              Cargo          @relation(fields: [cargoId], references: [id], onDelete: Cascade)
  items              DeliveryItem[]
  clientId           Int?           @map("client_id")
  clientName         String         @map("client_name")
  clientDocument     String?        @map("client_document")
  clientAddress      String?        @map("client_address")
  clientNeighborhood String?        @map("client_neighborhood")
  clientCity         String         @map("client_city")
  clientState        String?        @map("client_state") @db.Char(2)
  clientZipCode      String?        @map("client_zip_code")
  clientPhone        String?        @map("client_phone")
  client             Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@unique([cargoId, sequence])
  @@index([clientId])
  @@map("deliveries")
}

model DeliveryItem {
  id             Int      @id @default(autoincrement())
  deliveryId     Int      @map("delivery_id")
  productId      Int?     @map("product_id")
  code           String?
  product        String
  quantity       Int
  volumeCount    Int?     @map("volume_count")
  weight         Decimal? @db.Decimal(10, 3)
  notes          String?  @db.Text
  delivery       Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  catalogProduct Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  volumes        Volume[]

  @@index([deliveryId])
  @@index([productId])
  @@map("delivery_items")
}

model Volume {
  id             Int          @id @default(autoincrement())
  deliveryItemId Int          @map("delivery_item_id")
  number         Int
  code           String       @unique
  loaded         Boolean      @default(false)
  loadedAt       DateTime?    @map("loaded_at")
  loadedById     Int?         @map("loaded_by_id")
  deliveryItem   DeliveryItem @relation(fields: [deliveryItemId], references: [id], onDelete: Cascade)
  loadedBy       User?        @relation(fields: [loadedById], references: [id])
  scans          ScanLog[]

  @@unique([deliveryItemId, number])
  @@index([loadedById])
  @@map("volumes")
}

model ScanLog {
  id        Int        @id @default(autoincrement())
  code      String
  result    ScanResult
  volumeId  Int?       @map("volume_id")
  userId    Int        @map("user_id")
  createdAt DateTime   @default(now()) @map("created_at")
  volume    Volume?    @relation(fields: [volumeId], references: [id], onDelete: SetNull)
  user      User       @relation(fields: [userId], references: [id])

  reason  ScanReason?
  cargoId Int?        @map("cargo_id")
  device  String?
  cargo   Cargo?      @relation(fields: [cargoId], references: [id], onDelete: SetNull)

  @@index([cargoId])
  @@index([volumeId])
  @@index([userId])
  @@index([code])
  @@index([createdAt])
  @@map("scan_logs")
}
