{
  "name": "wms-server",
  "version": "0.0.5",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "build:frontend": "cd ../frontend && npm run build",
    "copy:frontend": "rm -rf public/dist/frontend/browser && mkdir -p public/dist/frontend/browser && cp -r ../frontend/dist/frontend/browser/. public/dist/frontend/browser/",
    "preinstaller:win": "npm run build && npm run build:frontend && npm run copy:frontend",
    "installer:win": "npm run build:bundle && cp release/server.js nsis-installer-windows/server.js && cp .env nsis-installer-windows/.env && cp -r public nsis-installer-windows/public && cd nsis-installer-windows && bash build.sh",
    "prisma:generate": "npx prisma generate",
    "prisma:migrate": "npx prisma migrate dev",
    "prisma:reset": "npx prisma migrate reset --force",
    "prisma:studio": "npx prisma studio",
    "prisma:seed": "npx tsx prisma/seeds/seed.ts",
    "build:bundle": "npx esbuild dist/src/main.js --bundle --platform=node --target=node18 --outfile=release/server.js --minify --external:@nestjs/microservices --external:class-transformer/storage --external:@fastify/static",
    "release": "npm run build && npm run build:bundle",
    "manager-db:win": "npm run build && npx esbuild dist/src/core/scripts/manager-database.js --bundle --platform=node --target=node18 --outfile=release/manager-database.js --minify --packages=external && npx pkg release/manager-database.js --targets node18-win-x64 --output release/manager-database.exe",
    "manager-db:linux": "npm run build && npx esbuild dist/src/core/scripts/manager-database.js --bundle --platform=node --target=node18 --outfile=release/manager-database.js --minify --packages=external && npx pkg release/manager-database.js --targets node18-linux-x64 --output release/manager-database-linux",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/serve-static": "^5.0.5",
    "@nestjs/swagger": "^11.4.7",
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.7",
    "jsonwebtoken": "^9.0.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "prettier": "^3.4.2",
    "prisma": "^7.10.0",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
